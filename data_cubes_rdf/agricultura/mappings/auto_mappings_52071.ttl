inelod:52071_Observations a rr:TriplesMap ;
    rml:logicalSource [ rml:referenceFormulation ql:CSV ;
            rml:source "C:\\Users\\dconde\\Desktop\\LinkedOpenDataINE\\_prepared_csv\\52071.csv" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rml:reference "Total_Nacional" ] ;
            rr:predicate inelod-voc:territorialTotals ],
        [ rr:objectMap [ rml:reference "Total" ;
                    rr:datatype xsd:float ] ;
            rr:predicate sdmx-measure:obsValue ],
        [ rr:objectMap [ rml:reference "Cultivos_pastos_y_huertos" ] ;
            rr:predicate inelod-voc:cropsPasruresAndOrchards ],
        [ rr:objectMap [ rml:reference "Provincias" ] ;
            rr:predicate inelod-voc:provinces ],
        [ rr:objectMap [ rml:reference "Caracteristicas_basicas_de_la_explotacion" ] ;
            rr:predicate inelod-voc:basicFarmCharacteristics ],
        [ rr:objectMap [ rml:reference "SAU" ] ;
            rr:predicate inelod-voc:sau ],
        [ rr:objectMap [ rml:reference "SAU_y_Otras_tierras" ] ;
            rr:predicate inelod-voc:sauAndOtherLands ],
        [ rr:objectMap [ rml:reference "Municipios" ] ;
            rr:predicate inelod-voc:municipalities ],
        [ rr:objectMap [ rml:reference "Comunidades_y_Ciudades_Autonomas" ] ;
            rr:predicate inelod-voc:ccaa ],
        [ rr:objectMap [ rml:reference "Comarcas" ] ;
            rr:predicate inelod-voc:regions ],
        [ rr:object inelod:52071 ;
            rr:predicate qb:dataSet ] ;
    rr:subjectMap [ rr:class qb:Observation ;
            rr:template "http://lod.ine.es/recurso/cubes/52071/o{index}" ] .

