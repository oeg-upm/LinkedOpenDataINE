@prefix ine: <http://lod.ine.es/def/vocabulary/>. 
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .
@prefix sdmx-measure: <http://purl.org/linked-data/sdmx/2009/measure#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix sdmx-concept:    <http://purl.org/linked-data/sdmx/2009/concept#> .
@prefix sdmx-code:    <http://purl.org/linked-data/sdmx/2009/code#> .
@prefix unit: <http://qudt.org/vocab/unit#> .
@prefix sdmx:    <http://purl.org/linked-data/sdmx#> .
@prefix places:        <http://purl.org/ontology/places#> .

# Ontology declaration and metadata. 

ine: a owl:Ontology ;
    cc:license <https://creativecommons.org/licenses/by/4.0/legalcode> ;
    dcterms:creator "Diego Conde-Herreros";
    dcterms:contributor "Diego Conde-Herreros", "Oscar Corcho", "Luis M. Vilches-Blázquez" ;";
    dcterms:created "2025-05-01"^^xsd:date ;
    dcterms:modified "2025-09-23"^^xsd:date;
    vann:preferredNamespacePrefix "ine" ;
    vann:preferredNamespaceUri <http://lod.ine.es/def/vocabulary/> ; 
    owl:versionIRI <http://lod.ine.es/def/vocabulary/1.0.0> ; 
    owl:versionInfo "1.0.0"@en;
    dcterms:description "An ontology for describing the variables used as dimensions and measures in the RDF data cubes from the Instituto Nacional de Estadística"@en, 
                        "Una ontologia para describir las variables empleadas como dimensiones y medidas en los cubos de datos en RDF del Instituto Nacional de Estadística"@es ;
    dcterms:title "INELOD VOC" .

# Reused Ontology terms from other vocabularies.


sdmx-dimension:refArea a qb:DimensionProperty, rdf:Property;
    rdfs:range rdfs:Resource;
    rdfs:label "Reference Area"@en .
sdmx-dimension:educationLev a qb:DimensionProperty, rdf:Property.
sdmx-dimension:currency a qb:DimensionProperty, rdf:Property;
    rdfs:range rdfs:Resource;
    rdfs:label "Currency"@en .
foaf:surname a rdf:Property.
foaf:name a rdf:Property.
qb:Observation a rdfs:Class, owl:Class.
qb:DimensionProperty a rdfs:Class, owl:Class.
skos:Concept a owl:Class.
qb:MeasureProperty a rdfs:Class .
sdmx-measure:obsValue a qb:MeasureProperty, rdf:Property ;
    rdfs:label "Observation"@en ;
    rdfs:range rdfs:Resource .
sdmx-measure:currency a qb:MeasureProperty, rdf:Property  ;
    rdfs:label "Currency"@en ;
    rdfs:range sdmx-code:currency .
unit:PERCENT a owl:Class . 
sdmx-code:currency a skos:ConceptScheme, sdmx:CodeList;
    skos:prefLabel "code list for Currency (CURRENCY) - codelist scheme"@en;
    rdfs:label "code list for Currency (CURRENCY) - codelist scheme"@en;
    skos:notation "CL_CURRENCY";
    skos:note """This code list provides code values for currencies."""@en;
    skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf> ;
    rdfs:seeAlso sdmx-code:Currency .

# The type of reason class that will be reused as a range for some dimensions.
ine:ReasonType a rdfs:Class, owl:Class ;
    rdfs:label "Reason type"@en , "Tipo de razón"@es ;
    rdfs:comment "La causa o la razón que mueve algo"@es, "The cause or reason that moves something"@en .

# The Ontology.

ine:territorialTotals
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Territorial totals"@en ,
    "Total Nacional"@es ,
    "Totales Territoriales"@es ,
    "NAC"@es .

ine:ccaa
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range skos:Concept ;
    rdfs:comment "Una comunidad autónoma (C. A.) es una entidad territorial que, dentro del actual ordenamiento jurídico constitucional, está dotada de autonomía, con instituciones y representantes propios y determinadas competencias legislativas, ejecutivas y administrativas, lo que la asimila en muchos aspectos a entidades federadas."@es;
    rdfs:label "Autonomous communities and cities"@en , "Comunidades y Ciudades Autónomas"@es , "Comunidades y ciudades autonomas"@es, "CCAA"@es, "Comunidades autónomas"@es, "Comunidad autónoma de destino"@es ;
    qb:concept  <http://lod.ine.es/kos/ccaa/CCAA> .


ine:cropsPasruresAndOrchards
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Crops, pastures and orchards"@en ,
    "Cultivos, pastos y huertos"@es .


ine:provinces
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range skos:Concept ;
    rdfs:comment "La provincia es una entidad local con personalidad jurídica propia, determinada por la agrupación de municipios y división territorial para el cumplimiento de las actividades del Estado. Cualquier alteración de los límites provinciales habrá de ser aprobada por las Cortes Generales mediante ley orgánica."@es ;
    rdfs:label "Provinces"@en, "Provincias"@es, "PROV"@es ;
    qb:concept  <http://lod.ine.es/kos/provincias/PROVINCIAS>  .


ine:sauAndOtherLands
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:comment "Es el conjunto de la superficie de tierras labradas y tierras para pastos permanentes. Las tierras labradas comprenden los cultivos herbáceos, los barbechos, los huertos familiares y las tierras consagradas a cultivos leñosos."@es ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "SAU and Other lands"@en ,
    "SAU y Otras tierras"@es .


ine:municipalities
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:subPropertyOf sdmx-dimension:refArea ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    qb:concept ine:Municipality;
    rdfs:comment "El municipio es la entidad local básica de la organización territorial del Estado. Tiene personalidad jurídica y plena capacidad para el cumplimiento de sus fines."@es ;
    rdfs:label "Municipalities"@en ,
    "Municipios"@es ,"Capitales de provincia y principales ciudades"@es,
    "Capitales y grandes ciudades"@es,
    "MUN"@es .


ine:subcity
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Sub-city"@en ,
    "Subciudad"@es ,
    "SUBCITY"@es .


ine:supracity
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Supra-city"@en ,
    "Supraciudad"@es ,
    "FUA"@es .


ine:conurbation
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:comment "Una ciudad se denominará conurbación o gran ciudad si más del 25% de la población de su centro urbano se encuentra fuera del área municipal. La conurbación estará formada por la ciudad y los municipios circundantes donde se extiende el centro urbano. En estos municipios, al menos el 50% de la población debe residir en el centro urbano."@es ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Conurbation"@en ,
    "Conurbación"@es ,
    "KERNEL"@es .


ine:districts
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Districts"@en ,
    "Distritos"@es ,
    "DIST"@es ;
    rdfs:comment "Dimensión territorial a nivel de distrito municipal. Apunta a recursos de tipo ine:District."@es .


ine:sections
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Sections"@en ,
    "Secciones"@es ,
    "SECCIONES "@es,
    "SECC"@es ,
    "Sections of CNAE 2009"@en ,
    "Secciones de la CNAE 2009"@es ,
    "Sections and subsections of CNAE-93"@en ,
    "Secciones y subsecciones de la CNAE-93"@es ,
    "Sections and subsections (Base 2000)"@en ,
    "Secciones y subsecciones (Base 2000)"@es ,
    "Sections and subsections (Base 90)"@en ,
    "Secciones y subsecciones (Base 90)"@es ,
    "Calendar-adjusted sections of CNAE 2009"@en ,
    "Secciones corregidas de efecto calendario de la CNAE 2009"@es .



ine:typeOfTrade
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range skos:Concept ;
    rdfs:label "Type of trade"@en ,
    "Tipo de comercio"@es .


ine:productGroups
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range skos:Concept ;
    rdfs:label "Product groups"@en ,
    "Grupos de Productos"@es .

sdmx-dimension:refPeriod a qb:DimensionProperty, rdf:Property ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource;
    qb:concept sdmx-concept:refPeriod ;
    rdfs:label "Reference Period"@en , "Period"@en, "Periodo"@es, "TIME_PERIOD"@en ;
    rdfs:comment """The period of time or point in time to which the measured observation is intended to refer."""@en ;
    rdfs:isDefinedBy <https://sdmx.org/wp-content/uploads/01_sdmx_cog_annex_1_cdc_2009.pdf> .


ine:componentsPIBpmSupply
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "PIBpm components, supply "@en ,
    "PIBpm componentes, oferta"@es ,
    "GDP components, supply (to be phased out)"@en ,
    "Componentes PIBpm, oferta (a desaparecer)"@es .

ine:PIBDataType  a rdf:Property, qb:DimensionProperty;
    rdfs:label "Tipo de dato de PIB"@es;
    rdfs:comment "Incluye: Datos no ajustados de estacionalidad y calendario, y Datos ajustados de estacionalidad y calendario"@es;
    rdfs:domain qb:Observation;
    rdfs:range xsd:String.


ine:compontentsPIBpmDemand
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "PIBpm components, demand"@en ,
    "Componentes PIBpm, demanda"@es ,
    "PIBpm components, demand (to be phased out)"@en ,
    "Componentes PIBpm, demanda (a desaparecer)"@es .


ine:statistics
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Statistics"@en ,
    "Estadística"@es .


ine:prices
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Prices"@en ,
    "Precios"@es,
    "SEC prices"@en ,
    "Precios_SEC"@es .


ine:operationsAndBalancesNational
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Operations and balances (national)"@en ,
    "Operaciones y saldos (nacionales)"@es ,
    "Operations and balances (with rest of world)"@en ,
    "Operaciones y saldos (con el resto del mundo)"@es .



ine:economicActivity
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "Se define como la generación de valor añadido mediante la producción de bienes y servicios."@es ;
    rdfs:label "Activity branches"@en ,
    "Ramas de actividad"@es ,
    "Activity branches and households"@en ,
    "Ramas de actividad y Hogares"@es ,
    "Activity branch - CNAE93"@en ,
    "Rama de actividad - CNAE93"@es ,
    "Activity branch CNAE 2009"@en ,
    "Rama de actividad CNAE 2009"@es ,
    "Activity branch (main job) CNAE 2009"@en ,
    "Rama de actividad (empleo principal) CNAE 2009"@es,
    "Economic activities (Historical Base 90)"@en ,
    "Actividades económicas (Histórico Base 90)"@es ,
    "Main activity"@en ,
    "Actividad principal"@es ,
    "Economic activity (CNAE-93)"@en ,
    "Actividad económica (CNAE-93)"@es ,
    "Economic activity (CNAE-09)"@en ,
    "Actividad económica (CNAE-09)"@es .

ine:economicSector 
    a rdf:Property, qb:DimensionProperty;
    rdfs:label "Sector económico"@es, "Economic sectors"@en , "Sectores económicos"@es ,"Economic Sector"@en ,"Sector de actividad"@es;
    rdfs:domain qb:Observation;
    rdfs:range skos:Concept.


ine:employmentAggregates
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Employment aggregates"@en ,
    "Agregados de empleo"@es .

ine:macroeconomicalAggregates  a rdf:Property, qb:DimensionProperty;
    rdfs:label "Agregados macroeconómicos"@es;
    rdfs:comment "Los agregados macroeconómicos son valores que representan la suma de todos los datos individuales del conjunto de una economía."@es;
    rdfs:range rdfs:Resource.


ine:componentesPibpmRent
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Componentes PIBpm, rent"@en ,
    "Componentes PIBpm, renta"@es .


sdmx-dimension:sex a qb:DimensionProperty, rdf:Property ;
    rdfs:range rdfs:Resource;
    qb:concept sdmx-concept:sex ;
    rdfs:label "Sex"@en, "Sexo"@es, "Reference person gender"@en, "Sexo de la persona de referencia"@es ;
    rdfs:comment """The state of being male or female."""@en , "El sexo se refiere al sexo biológico de la persona. Según la OMS, el sexo hace referencia a las características biológicas y fisiológicas que definen a hombres y mujeres, mientras que el género se refiere a los roles, conductas, actividades y atributos construidos socialmente que una cultura determinada considera apropiados para hombres y mujeres. De acuerdo con esta descripción, la OMS considera que hombre y mujer son categorías de sexo, mientras que masculino y femenino son categorías de género."@es ;
    rdfs:isDefinedBy <https://sdmx.org/wp-content/uploads/01_sdmx_cog_annex_1_cdc_2009.pdf> .


ine:islands
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Islands"@en ,
    "Islas"@es .


ine:mainDwellingTenureRegime
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Main dwelling tenure regime"@en ,
    "Régimen de tenenecia de la vivienda principal"@es .


ine:hotWaterAvailability
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Hot water availability"@en ,
    "Disposición de agua caliente"@es .


ine:energySourceForWaterHeating
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Energy source for water heating"@en ,
    "Fuente de energía utilizada para calentar el agua"@es .


ine:heatingAvailability
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Heating availability"@en ,
    "Disposición de calefacción"@es .


ine:energySourceForHeating
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Energy source for heating"@en ,
    "Fuente de energía utilizada para la calefacción"@es .


ine:ownershipOfOtherDwellingsBesidesMain
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Ownership of other dwellings besides main"@en ,
    "Disposición de otras viviendas distintas de la principal"@es .


ine:householdsAndPersons
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Households and persons"@en ,
    "Hogares y personas"@es .


ine:municipalitySize
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Municipality size"@en ,
    "Tamaño del municipio"@es .


ine:populationDensity
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Population density"@en ,
    "Densidad de población"@es .


ine:householdComposition
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Household composition"@en ,
    "Composición del hogar"@es .


ine:householdType
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:comment "Clasificación de las diferentes composiciones de los hogares basadas en variables sociodemográficas como edad, sexo y parentesco de sus miembros."@es ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Household type"@en ,
    "Tipo de hogar"@es .


ine:mainHouseholdIncomeSource
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Main household income source"@en ,
    "Principal fuente de ingresos del hogar"@es .


ine:householdRegularNetMonthlyIncomeLevel
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Household regular net monthly income level"@en ,
    "Nivel de ingresos mensuales netos regulares del hogar"@es .

ine:expenditureGroups
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Expenditure groups"@en ,
    "Grupos de gasto"@es .


ine:expenditureGroups2Digits
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ine:expenditureGroups ;
    rdfs:label "Expenditure groups (2 digits)"@en ,
    "Grupos de gasto (2 dígitos)"@es .


ine:totalExpensesAvgPercentageandIndexAboveAVGExpenditure
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Total expenses, averages, percentage distribution, and indices above the average expenditure"@en ,
    "Gastos totales, medios, distribución porcentual e índices sobre la media del gasto"@es .


ine:averageQuantitiesConsumed
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf sdmx-dimension:age ;
    rdfs:label "Average quantities consumed"@en ,
    "Cantidades medias consumidas"@es .


ine:totalExpenditureAndUnitValue
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Total expenditure and unit value"@en ,
    "Gasto total y valor unitario"@es .


ine:baseYear
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf sdmx-dimension:refPeriod ;
    rdfs:label "Base year"@en , "Año Base"@es, "Anual"@es .

ine:expenditureSubgroups3Digits
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Expenditure subgroups (3 digits)"@en ,
    "Subgrupos de gasto (3 dígitos)"@es .

ine:expenditureCodes
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Expenditure codes"@en ,
    "Códigos de gasto"@es .


ine:expenditureCodes4Digits
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ine:expenditureCodes ;
    rdfs:label "Expenditure codes (4 digits)"@en ,
    "Códigos de gasto (4 dígitos)"@es .


ine:expenditureCodes5Digits
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ine:expenditureCodes ;
    rdfs:label "Expenditure codes (5 digits)"@en ,
    "Códigos de gasto (5 dígitos)"@es .


ine:expenditureCodesWithPhysicalQuantity
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf ine:expenditureCodes ;
    rdfs:label "Expenditure codes with physical quantity"@en ,
    "Códigos de gasto con cantidad física"@es .


ine:totalAndAverageExpenditureMonetary
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf sdmx-dimension:age ;
    rdfs:label "Total and average expenditure (monetary)"@en ,
    "Gastos totales y medios (monetario)"@es .


ine:keyEconomicVariables
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "Key economic variables"@en ,
    "Principales variables económicas"@es .


ine:personshours
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Persons/Hours"@en ,
    "Personas/Horas"@es .


ine:categoryType
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "CATEGORY TYPE"@en ,
    "TIPO DE CATEGORIA"@es .


ine:touristAreas
    rdf:type rdf:Property , qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range rdfs:Resource ;
    rdfs:label "TOURIST AREAS"@en ,
    "ZONAS TURÍSTICAS"@es .


ine:residenceOrigin
    rdf:type rdf:Property , qb:DimensionProperty ;
