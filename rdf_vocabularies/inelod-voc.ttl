############ Extensión para el los indicadores de gentrificación. ##############################

##############################################################################
# Extensiones del INELOD-Voc para la aplicación de cálculo de indicadores de gentrificación (Madrid)
# Diego Conde-Herreros et al. — 2026
##############################################################################

########################################################################
# 1. CLASES TERRITORIALES NUEVAS
########################################################################
ine:District a rdfs:Class, owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "District"@en , "Distrito"@es ;
    rdfs:comment "Subdivisión administrativa de un municipio. En municipios grandes (Madrid, Barcelona, Valencia, etc.) los distritos agrupan secciones censales y son la unidad territorial intermedia entre el municipio y la sección censal."@es .

ine:CensusSection a rdfs:Class, owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Census section"@en , "Sección censal"@es ;
    rdfs:comment "Unidad territorial de menor nivel definida por el INE para la organización del Censo Electoral. Identificada por un código de 10 dígitos: 2 de provincia + 3 de municipio + 2 de distrito + 3 de sección."@es .

########################################################################
# 2. ANOTACIÓN SOBRE LA CLASE DE MUNICIPIO PREEXISTENTE
########################################################################
ine:Municipality rdfs:subClassOf skos:Concept .


########################################################################
# 3. DIMENSIÓN TERRITORIAL NUEVA: SECCIÓN CENSAL
########################################################################
ine:censusSection a rdf:Property, qb:DimensionProperty ;
    rdfs:subPropertyOf sdmx-dimension:refArea ;
    rdfs:domain qb:Observation ;
    rdfs:range ine:CensusSection ;
    rdfs:label "Census section"@en , "Sección censal"@es ;
    rdfs:comment "Dimensión territorial al nivel de sección censal. Cada sección censal pertenece a un distrito mediante skos:broader."@es .

########################################################################
# 4. MEDIDAS NUEVAS — CUBO ADRH
########################################################################

ine:eurosPerHousehold a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:euros ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Euros per household"@en , "Euros por hogar"@es ;
    rdfs:comment "Cantidad media en euros referida al hogar como unidad."@es, "Average amount in euros per household."@en .

ine:meanEurosPerConsumptionUnit a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:euros ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Mean income per consumption unit"@en ,
               "Media de la renta por unidad de consumo"@es ;
    rdfs:comment "Media de los ingresos del hogar divididos entre las unidades de consumo, calculadas según la escala OCDE modificada (1 para el primer adulto, 0,5 para el resto de mayores de 13 años, 0,3 para los menores de 14)."@es .

ine:medianEurosPerConsumptionUnit a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:euros ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Median income per consumption unit"@en ,
               "Mediana de la renta por unidad de consumo"@es ;
    rdfs:comment "Mediana de los ingresos del hogar divididos entre las unidades de consumo, según la escala OCDE modificada."@es .

ine:grossEurosPerInhabitant a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:eurosPerInhabitant ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Gross euros per inhabitant"@en ,
               "Renta bruta media por persona"@es ;
    rdfs:comment "Cantidad media en euros por habitante antes de impuestos y cotizaciones sociales."@es .

ine:grossEurosPerHousehold a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:eurosPerHousehold ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Gross euros per household"@en ,
               "Renta bruta media por hogar"@es ;
    rdfs:comment "Cantidad media en euros por hogar antes de impuestos y cotizaciones sociales."@es .

ine:giniIndex a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:index ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Gini index"@en , "Índice de Gini"@es ;
    rdfs:comment "Coeficiente de Gini de la distribución territorial de la renta. Toma valores entre 0 (igualdad perfecta) y 1 (desigualdad máxima)."@es, "Gini coefficient of the territorial distribution of income. Takes values between 0 (perfect equality) and 1 (maximum inequality)."@en .

ine:incomePercentileRatioP80P20 a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:rate ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Income percentile ratio P80/P20"@en ,
               "Ratio de percentiles de renta P80/P20"@es ;
    rdfs:comment "Cociente entre la renta del percentil 80 y la del percentil 20 de la distribución territorial de ingresos. Es una medida estándar de desigualdad de ingresos."@es .

ine:percentageBelowPovertyThreshold a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:percentageOfPeople ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Percentage of population below poverty threshold"@en ,
               "Porcentaje de población bajo umbral de pobreza"@es ;
    rdfs:comment "Porcentaje de población en el territorio cuya renta neta por unidad de consumo es inferior al 60% de la mediana nacional."@es, "Percentage of population in the territory whose net income per consumption unit is below 60% of the national median."@en .


########################################################################
# 5. MEDIDAS NUEVAS — CUBO VIVIENDAS TURÍSTICAS
########################################################################

ine:touristDwellings a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:apartments ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:integer ;
    rdfs:label "Tourist dwellings"@en , "Viviendas turísticas"@es ;
    rdfs:comment "Número de viviendas de uso turístico identificadas según la Medición experimental del INE basada en plataformas de alquiler turístico."@es, "Number of tourist dwellings identified according to the experimental measurement by INE based on short-term rental platforms."@en .

ine:touristDwellingsRatio a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:percentage ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Tourist dwellings ratio"@en ,
               "Porcentaje de viviendas turísticas sobre el parque total"@es ;
    rdfs:comment "Cociente entre el número de viviendas de uso turístico y el parque residencial total del territorio, expresado como porcentaje."@es, "Quotient between the number of tourist dwellings and the total residential stock of the territory, expressed as a percentage."@en .

ine:meanAge a rdf:Property, qb:MeasureProperty ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Mean age"@en , "Edad media"@es ;
    rdfs:comment "Edad media de la población residente en la unidad territorial, expresada en años."@es .

ine:percentageOfYoungPopulation a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:percentageOfPeople ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Percentage of young population (under 18)"@en ,
               "Porcentaje de población menor de 18 años"@es ;
    rdfs:comment "Porcentaje de personas menores de 18 años sobre el total de la población del territorio."@es .

ine:percentageOfElderlyPopulation a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:percentageOfPeople ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Percentage of elderly population (65 and over)"@en ,
               "Porcentaje de población de 65 y más años"@es ;
    rdfs:comment "Porcentaje de personas de 65 años o más sobre el total de la población del territorio."@es .

ine:meanHouseholdSize a rdf:Property, qb:MeasureProperty ;
    ine:inMeasureSet ine:measures ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Mean household size"@en , "Tamaño medio del hogar"@es ;
    rdfs:comment "Número medio de personas por hogar en el territorio."@es .

ine:percentageOfSingleHouseholds a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:percentage ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Percentage of single-person households"@en ,
               "Porcentaje de hogares unipersonales"@es ;
    rdfs:comment "Porcentaje de hogares formados por una sola persona sobre el total de hogares del territorio."@es .

ine:totalPopulation a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:population ;
    ine:inMeasureSet ine:count ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:integer ;
    rdfs:label "Total population"@en , "Población total"@es ;
    rdfs:comment "Número total de personas residentes en el territorio."@es .

ine:percentageOfSpanishPopulation a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:percentageOfPeople ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Percentage of Spanish population"@en ,
               "Porcentaje de población española"@es ;
    rdfs:comment "Porcentaje de población con nacionalidad española sobre el total de la población del territorio."@es .

########################################################################
# 6. MEDIDA NUEVA — CUBO DE INDICADORES DERIVADOS
########################################################################

ine:gentrificationIndex a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:indexRangeScaled ;
    ine:inMeasureSet ine:indicators ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Gentrification index"@en , "Índice de gentrificación"@es ;
    rdfs:comment "Índice compuesto que mide la intensidad del fenómeno de gentrificación en una unidad territorial, calculado como combinación lineal ponderada de indicadores elementales normalizados por percentiles. Toma valores entre 0 y 100."@es .


########################################################################
# 7. DIMENSIONES NUEVAS — IDENTIFICACIÓN DE INDICADORES Y CONFIGURACIÓN
########################################################################

ine:indicator a rdf:Property, qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range skos:Concept ;
    rdfs:label "Indicator"@en , "Indicador"@es ;
    rdfs:comment "Dimensión que identifica de qué indicador se trata cada observación dentro de un cubo de indicadores derivados."@es, "Dimension that identifies the indicator for each observation within a derived indicators cube."@en .

ine:weightingConfiguration a rdf:Property, qb:DimensionProperty ;
    rdfs:domain qb:Observation ;
    rdfs:range skos:Concept ;
    rdfs:label "Weighting configuration"@en , "Configuración de pesos"@es ;
    rdfs:comment "Dimensión que identifica la configuración de pesos utilizada para calcular un indicador compuesto. Permite que un mismo cubo contenga el indicador calculado con varias configuraciones distintas."@es, "Dimension that identifies the weighting configuration used to calculate a composite indicator. Allows the same cube to contain the indicator calculated with various distinct configurations."@en .

ine:bedplacesPerTouristDwelling a rdf:Property, qb:MeasureProperty ;
    rdfs:subPropertyOf ine:rate ;
    ine:inMeasureSet ine:rate ;
    rdfs:domain qb:Observation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Bedplaces per tourist dwelling"@en ,
               "Plazas por vivienda turística"@es ;
    rdfs:comment "Número medio de plazas por vivienda turística en el territorio. Publicado por el INE en la Medición experimental de viviendas turísticas."@es .